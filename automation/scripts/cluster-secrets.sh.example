#!/usr/bin/env bash
# cluster-secrets.sh — credenciais e decisões específicas do seu cluster.
# Carregado automaticamente pelo cluster-env.sh.
#
# Onde copiar:
#   ~/cluster-secrets.sh                 (user-scoped, vale pra todos os repos)
#   automation/cluster-secrets.sh        (project-scoped, gitignored)
#
# NÃO commite o arquivo `cluster-secrets.sh` (sem `.example`) — tem credenciais.

# ============================================================
# DNS provider — credenciais (escolha o seu)
# ============================================================

# --- AWS Route 53 ---
# IMPORTANTE: em sandbox/lab AWS (perfil aws-lab) NÃO setar nada abaixo. O role
# letsencrypt auto-descobre credenciais do Secret kube-system/aws-creds e a
# hosted zone via Route53 API (NS-match com o domínio do cluster). Hardcoding
# aqui vira bug silencioso quando você troca de sandbox: install-all completa,
# mas o ACME challenge fica pending (InvalidClientTokenId → NoSuchHostedZone)
# e o cert TLS do gateway nunca emite, prendendo keycloak em ContainerCreating.
# Veja docs/cluster-secrets.md.
#
# Só setar quando o auto-discover NÃO se aplica (cluster não-IPI, ou creds de
# DNS distintas das do instalador em prod):
# export RHCL_DNS_AWS_ACCESS_KEY_ID="AKIA..."
# export RHCL_DNS_AWS_SECRET_ACCESS_KEY="..."
# export LETSENCRYPT_AWS_HOSTED_ZONE_ID="Z123ABC..."   # zone do CLUSTER ATUAL, não reutilize entre sandboxes

# --- Azure DNS ---
# export RHCL_DNS_AZURE_JSON_FILE="$HOME/.azure/sp-credentials.json"
# export AZ_DNS_ZONE="example.com"

# --- GCP Cloud DNS ---
# export RHCL_DNS_GCP_PROJECT_ID="my-project"
# export RHCL_DNS_GCP_GOOGLE_FILE="$HOME/.gcp/sa-key.json"

# ============================================================
# Let's Encrypt (perfil aws-lab)
# ============================================================
# export LETSENCRYPT_EMAIL="ops@example.com"
# export LETSENCRYPT_PROD_ENABLED=true                  # default false (só staging)

# ============================================================
# Quay images (opcional — só se preferir imagens pré-buildadas ao build local)
# ============================================================
# export APPS_IMAGE_SOURCE="quay"
# export APPS_BACKEND_IMAGE_QUAY="quay.io/<sua-conta>/banking-api:backend"
# export APPS_FRONTEND_IMAGE_QUAY="quay.io/<sua-conta>/mobile-bank:frontend"

# ============================================================
# Hostnames explícitos (override do default que deriva de RHCL_ZONE_ROOT_DOMAIN)
# ============================================================
# export APPS_CONNECTIVITY_ROUTE_HOSTNAME="banking-api.poc.example.com"
# export APPS_CONNECTIVITY_FRONTEND_ROUTE_HOSTNAME="mobile-bank.poc.example.com"

# ============================================================
# APIKeys tiered — sobrescreva pra usar chaves geradas
# ============================================================
# export APPS_CONNECTIVITY_APIKEY_GOLD="alice-gold-secret"
# export APPS_CONNECTIVITY_APIKEY_SILVER="bob-silver-secret"
# export APPS_CONNECTIVITY_APIKEY_BRONZE="carol-bronze-secret"

# ============================================================
# Force profile (se a auto-detecção errar)
# ============================================================
# Nenhum aqui — passe --profile=aws na linha de comando:
#   source automation/scripts/cluster-env.sh --profile=aws
