apiVersion: v1
kind: ConfigMap
metadata:
  name: rhdh-app-config
  namespace: {{ developer_hub_namespace }}
data:
  app-config.yaml: |
    app:
      title: {{ developer_hub_app_title }}
    backend:
      auth:
        dangerouslyDisableDefaultAuthPolicy: false
    # Render the OIDC (Keycloak) sign-in card. Without this RHDH falls
    # back to its built-in `github` provider — which the backend doesn't
    # register, so the UI shows a GitHub card that 404s with
    # "No auth provider registered for github".
    signInPage: oidc
    auth:
      environment: production
      # OIDC (OAuth) keeps flow state in a session cookie; without a
      # session secret the backend errors "authentication requires
      # session support" on /api/auth/oidc/start.
      session:
        secret: ${AUTH_SESSION_SECRET}
      providers:
        oidc:
          production:
            metadataUrl: ${OIDC_ISSUER}/.well-known/openid-configuration
            clientId: ${OIDC_CLIENT_ID}
            clientSecret: ${OIDC_CLIENT_SECRET}
            prompt: auto
            signIn:
              resolvers:
                # PoC/demo: allow sign-in even without a matching User
                # entity in the Backstage catalog (we don't ingest
                # Keycloak users here). Without this the login fails with
                # "unable to resolve user identity". Pair with explicit
                # user→role bindings in rbac-policy.csv. For production,
                # ingest users/groups via the Keycloak catalog module and
                # drop this flag.
                - resolver: preferredUsernameMatchingUserEntityName
                  dangerouslyAllowSignInWithoutUserInCatalog: {{ developer_hub_allow_signin_without_catalog | lower }}
    permission:
      enabled: true
      rbac:
        policies-csv-file: /opt/app-root/etc/rbac-policy.csv
        policyFileReload: true
    catalog:
      rules:
        - allow: [Component, System, API, APIProduct, Resource, Location]
    kubernetes:
      serviceLocatorMethod:
        type: multiTenant
      clusterLocatorMethods:
        - type: config
          clusters:
            - name: local-cluster
              url: https://kubernetes.default.svc
              authProvider: serviceAccount
              skipTLSVerify: true
              # Required by the Kuadrant backend plugin (see install.yml).
              serviceAccountToken: ${K8S_SA_TOKEN}
