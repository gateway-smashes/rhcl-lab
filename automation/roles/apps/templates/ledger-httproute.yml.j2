apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: {{ apps_ledger_route_name }}
  namespace: {{ apps_namespace }}
  labels:
    app.kubernetes.io/part-of: rhcl-banking-poc
    rhcl.poc/item: "38"
spec:
  parentRefs:
  - name: {{ apps_connectivity_gateway_name }}
    namespace: {{ apps_connectivity_gateway_namespace }}
    sectionName: {{ apps_ledger_http_listener_name }}
  hostnames:
  - {{ apps_ledger_route_hostname_resolved | to_json }}
  rules:
  - matches:
    - path:
        type: PathPrefix
        value: /
    backendRefs:
    - name: {{ apps_ledger_name }}
      port: 8080
