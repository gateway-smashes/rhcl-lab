# Demo subscriber for the PIX product. The Secret's metadata.name is
# what shows up in the "Top consumers" ranking; the raw key the client
# must send is in stringData.api_key — kept aligned with what
# tests/simulate-api-traffic.sh --target=pix expects.
apiVersion: v1
kind: Secret
metadata:
  name: {{ apps_pix_apikey_tester_name }}
  namespace: {{ apps_namespace }}
  labels:
    authorino.kuadrant.io/managed-by: authorino
    app: {{ apps_pix_apikey_secret_name }}
    app.kubernetes.io/part-of: rhcl-banking-poc
  annotations:
    secret.kuadrant.io/user-id: "pix-tester"
    secret.kuadrant.io/plan-id: "pix-default"
type: Opaque
stringData:
  api_key: {{ apps_pix_apikey_secret_value | string | to_json }}
