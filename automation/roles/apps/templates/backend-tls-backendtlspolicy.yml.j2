apiVersion: gateway.networking.k8s.io/v1
kind: BackendTLSPolicy
metadata:
  name: {{ apps_backend_tls_route_policy_name }}
  namespace: {{ apps_namespace }}
  labels:
    app.kubernetes.io/part-of: rhcl-backend-tls-poc
    rhcl.poc/item: "47"
spec:
  targetRefs:
    - group: gateway.networking.k8s.io
      kind: HTTPRoute
      name: {{ apps_backend_tls_route_name }}
  validation:
    hostname: {{ apps_backend_tls_route_backend_hostname }}
    caCertificateRefs:
      - group: ""
        kind: ConfigMap
        name: {{ apps_backend_tls_route_service_ca_configmap_name }}
