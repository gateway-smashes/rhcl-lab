apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: {{ apps_backend_tls_route_name }}
  namespace: {{ apps_namespace }}
  labels:
    app.kubernetes.io/part-of: rhcl-backend-tls-poc
    rhcl.poc/item: "47"
spec:
  parentRefs:
    - name: {{ apps_connectivity_gateway_name }}
      namespace: {{ apps_connectivity_gateway_namespace }}
  hostnames:
    - {{ apps_backend_tls_route_hostname_resolved | to_json }}
  rules:
    - matches:
        - path:
            type: PathPrefix
            value: /api/tls/info
          method: GET
      filters:
        - type: ResponseHeaderModifier
          responseHeaderModifier:
            set:
              - name: Strict-Transport-Security
                value: max-age=31536000; includeSubDomains
              - name: Access-Control-Allow-Origin
                value: {{ apps_backend_tls_route_cors_allow_origin | string | to_json }}
              - name: Access-Control-Allow-Methods
                value: "GET,OPTIONS"
              - name: Access-Control-Allow-Headers
                value: "accept,content-type,x-requested-with"
              - name: Access-Control-Max-Age
                value: "86400"
              - name: Vary
                value: "Origin"
      backendRefs:
        - name: {{ apps_backend_primary_name }}
          port: {{ apps_backend_https_port }}
