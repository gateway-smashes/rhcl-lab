apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: {{ apps_req048_route_name }}
  namespace: {{ apps_namespace }}
  labels:
    app.kubernetes.io/part-of: req048-grpc-backend
    rhcl.poc/item: "48"
spec:
  parentRefs:
  - name: {{ apps_connectivity_gateway_name }}
    namespace: {{ apps_connectivity_gateway_namespace }}
    sectionName: {{ apps_req048_http_listener_name }}
  hostnames:
  - {{ apps_req048_route_hostname_resolved | to_json }}
  rules:
  - matches:
    - path:
        type: PathPrefix
        value: /
    backendRefs:
    - name: {{ apps_req048_service_name }}
      port: 8080
