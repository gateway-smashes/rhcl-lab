apiVersion: kuadrant.io/v1
kind: TLSPolicy
metadata:
  name: {{ apps_connectivity_tls_policy_name }}
  namespace: {{ apps_connectivity_gateway_namespace }}
spec:
  targetRef:
    group: gateway.networking.k8s.io
    kind: Gateway
    name: {{ apps_connectivity_gateway_name }}
  issuerRef:
    group: {{ apps_connectivity_tls_issuer_group }}
    kind: {{ apps_connectivity_tls_issuer_kind }}
    name: {{ apps_connectivity_tls_issuer_name }}
