apiVersion: build.openshift.io/v1
kind: BuildConfig
metadata:
  name: {{ apps_ledger_image_name }}
  namespace: {{ apps_namespace }}
  labels:
    app.kubernetes.io/part-of: rhcl-banking-poc
    rhcl.poc/item: "38"
spec:
  output:
    to:
      kind: ImageStreamTag
      name: {{ apps_ledger_image_name }}:latest
  source:
    binary: {}
    type: Binary
  strategy:
    dockerStrategy:
      dockerfilePath: Dockerfile
    type: Docker
