apiVersion: v1
kind: Service
metadata:
  name: {{ apps_pix_service_name }}
  namespace: {{ apps_namespace }}
  labels:
    app: {{ apps_pix_deployment_name }}
    app.kubernetes.io/part-of: rhcl-banking-poc
spec:
  selector:
    app: {{ apps_pix_deployment_name }}
  ports:
    - name: http
      port: 8080
      targetPort: http
      protocol: TCP
