apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: {{ apps_pix_route_name }}
  namespace: {{ apps_namespace }}
  labels:
    app.kubernetes.io/part-of: rhcl-banking-poc
spec:
  parentRefs:
    - name: {{ apps_connectivity_gateway_name }}
      namespace: {{ apps_connectivity_gateway_namespace }}
  hostnames:
    - {{ apps_pix_route_hostname_resolved | quote }}
  rules:
    - matches:
        - path: { type: PathPrefix, value: /pix }
      backendRefs:
        - name: {{ apps_pix_service_name }}
          port: 8080
