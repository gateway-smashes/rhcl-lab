apiVersion: v1
kind: Service
metadata:
  name: {{ apps_req048_service_name }}
  namespace: {{ apps_namespace }}
  labels:
    app.kubernetes.io/part-of: req048-grpc-backend
    rhcl.poc/item: "48"
spec:
  selector:
    app: {{ apps_backend_primary_name }}
  ports:
  - name: grpc
    port: 8080
    targetPort: 8080
    protocol: TCP
    appProtocol: kubernetes.io/h2c
