# Bootstrap admin para o Keycloak — referenciado por spec.bootstrapAdmin.user.secret.
# Faz o Keycloak nascer com um admin DEFINITIVO (default admin/redhat) em vez do
# temp-admin + senha aleatória gerados pelo operator. Aplicado ANTES do CR Keycloak,
# pois só vale na criação inicial da instância.
apiVersion: v1
kind: Secret
metadata:
  name: {{ rhbk_admin_secret_name }}
  namespace: {{ rhbk_namespace }}
  labels:
    app.kubernetes.io/part-of: rhcl-req71-oidc-jwt
type: Opaque
stringData:
  username: {{ rhbk_admin_username }}
  password: {{ rhbk_admin_password }}
