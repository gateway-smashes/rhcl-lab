apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: {{ mcp_gateway_custom_route_name }}
  namespace: {{ mcp_gateway_namespace }}
spec:
  parentRefs:
    - name: {{ mcp_gateway_gateway_name }}
      namespace: {{ mcp_gateway_gateway_namespace }}
      sectionName: {{ mcp_gateway_listener_name }}
  hostnames:
    - {{ mcp_gateway_hostname_resolved | to_json }}
  rules:
    - matches:
        - path:
            type: PathPrefix
            value: {{ mcp_gateway_path | to_json }}
{% if mcp_gateway_custom_route_cors_enabled %}
      filters:
        - type: ResponseHeaderModifier
          responseHeaderModifier:
            add:
              - name: Access-Control-Allow-Origin
                value: "*"
              - name: Access-Control-Allow-Methods
                value: "GET, POST, PUT, DELETE, OPTIONS, HEAD"
              - name: Access-Control-Allow-Headers
                value: {{ mcp_gateway_custom_route_cors_allow_headers | to_json }}
              # Required for browsers to read MCP session id via JS (Access-Control-Expose-Headers).
              - name: Access-Control-Expose-Headers
                value: "MCP-Session-Id, mcp-session-id"
              - name: Access-Control-Max-Age
                value: "3600"
{% endif %}
      backendRefs:
        - name: {{ mcp_gateway_operator_name }}
          port: 8080
    - matches:
        - path:
            type: PathPrefix
            value: "/.well-known/oauth-protected-resource"
      backendRefs:
        - name: {{ mcp_gateway_operator_name }}
          port: 8080
