apiVersion: gateway.networking.k8s.io/v1beta1
kind: ReferenceGrant
metadata:
  name: {{ mcp_gateway_extension_name }}-to-gateway
  namespace: {{ mcp_gateway_gateway_namespace }}
spec:
  from:
    - group: mcp.kuadrant.io
      kind: MCPGatewayExtension
      namespace: {{ mcp_gateway_namespace }}
  to:
    - group: gateway.networking.k8s.io
      kind: Gateway
      name: {{ mcp_gateway_gateway_name }}
