apiVersion: v1
kind: Service
metadata:
  name: {{ mcp_gateway_compat_service_name }}
  namespace: {{ mcp_gateway_gateway_namespace }}
  labels:
    rhcl-lab/managed-by: mcp-gateway-role
    rhcl-lab/purpose: mcp-gateway-internal-routing
spec:
  type: ClusterIP
  selector:
    gateway.networking.k8s.io/gateway-name: {{ mcp_gateway_gateway_name }}
  ports:
    - name: mcp
      port: {{ mcp_gateway_port }}
      targetPort: {{ mcp_gateway_port }}
      protocol: TCP
      appProtocol: http
