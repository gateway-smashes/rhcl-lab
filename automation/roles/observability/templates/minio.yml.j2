apiVersion: v1
kind: Namespace
metadata:
  name: {{ observability_minio_namespace }}
---
apiVersion: v1
kind: Secret
metadata:
  name: minio-root
  namespace: {{ observability_minio_namespace }}
type: Opaque
stringData:
  MINIO_ROOT_USER: {{ observability_minio_root_user }}
  MINIO_ROOT_PASSWORD: {{ observability_minio_root_password }}
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: minio-data
  namespace: {{ observability_minio_namespace }}
spec:
  accessModes:
    - ReadWriteOnce
{% if observability_minio_storage_class | length > 0 %}
  storageClassName: {{ observability_minio_storage_class }}
{% endif %}
  resources:
    requests:
      storage: {{ observability_minio_storage_size }}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: minio
  namespace: {{ observability_minio_namespace }}
  labels:
    app: minio
spec:
  replicas: 1
  selector:
    matchLabels:
      app: minio
  template:
    metadata:
      labels:
        app: minio
    spec:
      securityContext:
        fsGroupChangePolicy: OnRootMismatch
      containers:
        - name: minio
          image: quay.io/minio/minio:latest
          imagePullPolicy: IfNotPresent
          args:
            - server
            - /data
            - --console-address
            - ":9001"
          envFrom:
            - secretRef:
                name: minio-root
          env:
            - name: HOME
              value: /tmp
          ports:
            - name: api
              containerPort: 9000
              protocol: TCP
            - name: console
              containerPort: 9001
              protocol: TCP
          volumeMounts:
            - name: data
              mountPath: /data
          readinessProbe:
            httpGet:
              path: /minio/health/ready
              port: api
            initialDelaySeconds: 10
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /minio/health/live
              port: api
            initialDelaySeconds: 20
            periodSeconds: 20
          resources:
            requests:
              cpu: 100m
              memory: 256Mi
            limits:
              cpu: 500m
              memory: 1Gi
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop:
                - ALL
            runAsNonRoot: true
            seccompProfile:
              type: RuntimeDefault
      volumes:
        - name: data
          persistentVolumeClaim:
            claimName: minio-data
---
apiVersion: v1
kind: Service
metadata:
  name: minio
  namespace: {{ observability_minio_namespace }}
  labels:
    app: minio
spec:
  selector:
    app: minio
  ports:
    - name: api
      port: 9000
      targetPort: api
      protocol: TCP
    - name: console
      port: 9001
      targetPort: console
      protocol: TCP
---
apiVersion: route.openshift.io/v1
kind: Route
metadata:
  name: minio-console
  namespace: {{ observability_minio_namespace }}
spec:
  to:
    kind: Service
    name: minio
  port:
    targetPort: console
  tls:
    termination: edge
    insecureEdgeTerminationPolicy: Redirect
---
apiVersion: batch/v1
kind: Job
metadata:
  name: minio-create-bucket
  namespace: {{ observability_minio_namespace }}
spec:
  backoffLimit: 10
  template:
    spec:
      restartPolicy: OnFailure
      containers:
        - name: mc
          image: quay.io/minio/mc:latest
          imagePullPolicy: IfNotPresent
          envFrom:
            - secretRef:
                name: minio-root
          env:
            - name: MC_CONFIG_DIR
              value: /tmp/.mc
          command:
            - /bin/sh
            - -c
          args:
            - |
              set -e
              echo "Waiting for MinIO..."
              until mc alias set local http://minio.{{ observability_minio_namespace }}.svc.cluster.local:9000 "${MINIO_ROOT_USER}" "${MINIO_ROOT_PASSWORD}"; do
                echo "MinIO not ready, retrying..."
                sleep 5
              done
              echo "Creating bucket {{ observability_minio_bucket }}..."
              mc mb -p local/{{ observability_minio_bucket }} || true
              mc anonymous set none local/{{ observability_minio_bucket }} || true
              echo "Bucket {{ observability_minio_bucket }} ready."
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop:
                - ALL
            runAsNonRoot: true
            seccompProfile:
              type: RuntimeDefault
---
apiVersion: v1
kind: Namespace
metadata:
  name: {{ observability_tempostack_namespace }}
---
apiVersion: v1
kind: Secret
metadata:
  name: tempo-storage
  namespace: {{ observability_tempostack_namespace }}
type: Opaque
stringData:
  endpoint: http://minio.{{ observability_minio_namespace }}.svc.cluster.local:9000
  bucket: {{ observability_minio_bucket }}
  access_key_id: {{ observability_minio_root_user }}
  access_key_secret: {{ observability_minio_root_password }}
