{
  "info": {
    "name": "RHCL Banking API (Gateway)",
    "description": "banking-api endpoints exposed by the Kuadrant Gateway. Authentication via API key in the `api-key` header. Set the `gateway_host` and `api_key` environment variables before running.",
    "_postman_id": "rhcl-banking-api-collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "gateway_host",
      "value": "banking-api-connectivity.apps.example.com",
      "description": "Gateway hostname (no scheme). Replace with your cluster domain."
    },
    {
      "key": "api_key",
      "value": "change-me",
      "description": "Value of the API key configured in the Authorino Secret (APPS_CONNECTIVITY_APIKEY_VALUE)."
    }
  ],
  "item": [
    {
      "name": "Banking — Accounts",
      "item": [
        {
          "name": "GET /api/v1/accounts/summary",
          "request": {
            "method": "GET",
            "header": [
              { "key": "api-key", "value": "{{api_key}}" },
              { "key": "x-flow-trace-id", "value": "postman-{{$randomUUID}}" },
              { "key": "x-client-app", "value": "postman" }
            ],
            "url": {
              "raw": "https://{{gateway_host}}/api/v1/accounts/summary",
              "protocol": "https",
              "host": ["{{gateway_host}}"],
              "path": ["api", "v1", "accounts", "summary"]
            },
            "description": "Account summary — backend v1. Returns balance, investments and available features."
          }
        },
        {
          "name": "GET /api/v2/accounts/summary",
          "request": {
            "method": "GET",
            "header": [
              { "key": "api-key", "value": "{{api_key}}" },
              { "key": "x-flow-trace-id", "value": "postman-{{$randomUUID}}" },
              { "key": "x-client-app", "value": "postman" }
            ],
            "url": {
              "raw": "https://{{gateway_host}}/api/v2/accounts/summary",
              "protocol": "https",
              "host": ["{{gateway_host}}"],
              "path": ["api", "v2", "accounts", "summary"]
            },
            "description": "Account summary — backend v2. Includes `scheduledTransfers: true` in the features."
          }
        },
        {
          "name": "POST /api/v1/accounts/reset",
          "request": {
            "method": "POST",
            "header": [
              { "key": "api-key", "value": "{{api_key}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-flow-trace-id", "value": "postman-{{$randomUUID}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bankName\": \"Example Bank\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "https://{{gateway_host}}/api/v1/accounts/reset",
              "protocol": "https",
              "host": ["{{gateway_host}}"],
              "path": ["api", "v1", "accounts", "reset"]
            },
            "description": "Resets the balance of a specific bank account on backend v1. Requires `bankName` in the body."
          }
        }
      ]
    },
    {
      "name": "Banking — Transfers",
      "item": [
        {
          "name": "POST /api/v1/transfers",
          "request": {
            "method": "POST",
            "header": [
              { "key": "api-key", "value": "{{api_key}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-flow-trace-id", "value": "postman-{{$randomUUID}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"from\": \"Example Bank\",\n  \"to\": \"Nubank\",\n  \"amount\": 150.00\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "https://{{gateway_host}}/api/v1/transfers",
              "protocol": "https",
              "host": ["{{gateway_host}}"],
              "path": ["api", "v1", "transfers"]
            },
            "description": "Makes a transfer — backend v1. Returns status `RECEIVED`."
          }
        },
        {
          "name": "POST /api/v2/transfers",
          "request": {
            "method": "POST",
            "header": [
              { "key": "api-key", "value": "{{api_key}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-flow-trace-id", "value": "postman-{{$randomUUID}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"from\": \"Example Bank\",\n  \"to\": \"Nubank\",\n  \"amount\": 150.00\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "https://{{gateway_host}}/api/v2/transfers",
              "protocol": "https",
              "host": ["{{gateway_host}}"],
              "path": ["api", "v2", "transfers"]
            },
            "description": "Makes a transfer — backend v2. Returns status `AUTHORIZED`."
          }
        }
      ]
    },
    {
      "name": "Echo",
      "item": [
        {
          "name": "GET /api/echo",
          "request": {
            "method": "GET",
            "header": [
              { "key": "api-key", "value": "{{api_key}}" },
              { "key": "x-flow-trace-id", "value": "postman-{{$randomUUID}}" },
              { "key": "x-custom-header", "value": "hello-from-postman" }
            ],
            "url": {
              "raw": "https://{{gateway_host}}/api/echo",
              "protocol": "https",
              "host": ["{{gateway_host}}"],
              "path": ["api", "echo"]
            },
            "description": "Returns all received headers, query params and cookies. Useful for inspecting what the gateway forwards."
          }
        },
        {
          "name": "POST /api/echo",
          "request": {
            "method": "POST",
            "header": [
              { "key": "api-key", "value": "{{api_key}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-flow-trace-id", "value": "postman-{{$randomUUID}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"hello\": \"world\",\n  \"test\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "https://{{gateway_host}}/api/echo",
              "protocol": "https",
              "host": ["{{gateway_host}}"],
              "path": ["api", "echo"]
            },
            "description": "Echoes back the received body and headers. Includes `x-echo-instance` and `x-echo-method` in the response headers."
          }
        }
      ]
    },
    {
      "name": "Whoami",
      "item": [
        {
          "name": "GET /api/whoami",
          "request": {
            "method": "GET",
            "header": [
              { "key": "api-key", "value": "{{api_key}}" },
              { "key": "x-flow-trace-id", "value": "postman-{{$randomUUID}}" }
            ],
            "url": {
              "raw": "https://{{gateway_host}}/api/whoami",
              "protocol": "https",
              "host": ["{{gateway_host}}"],
              "path": ["api", "whoami"]
            },
            "description": "Returns the caller identity inferred by the backend (headers propagated by the gateway/Authorino)."
          }
        }
      ]
    },
    {
      "name": "TLS Info",
      "item": [
        {
          "name": "GET /api/tls/info",
          "request": {
            "method": "GET",
            "header": [{ "key": "api-key", "value": "{{api_key}}" }],
            "url": {
              "raw": "https://{{gateway_host}}/api/tls/info",
              "protocol": "https",
              "host": ["{{gateway_host}}"],
              "path": ["api", "tls", "info"]
            },
            "description": "Information about the TLS certificate and protocol negotiated on the connection to the backend."
          }
        }
      ]
    },
    {
      "name": "AI Completions",
      "item": [
        {
          "name": "GET /api/v1/models",
          "request": {
            "method": "GET",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "https://{{gateway_host}}/api/v1/models",
              "protocol": "https",
              "host": ["{{gateway_host}}"],
              "path": ["api", "v1", "models"]
            },
            "description": "OpenAI-compatible model list (mock banking-mock-gpt)."
          }
        },
        {
          "name": "POST /api/v1/chat/completions (JSON)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-consumer-id", "value": "postman" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"banking-mock-gpt\",\n  \"messages\": [\n    { \"role\": \"user\", \"content\": \"What is the total balance of my accounts?\" }\n  ],\n  \"stream\": false\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "https://{{gateway_host}}/api/v1/chat/completions",
              "protocol": "https",
              "host": ["{{gateway_host}}"],
              "path": ["api", "v1", "chat", "completions"]
            },
            "description": "Mock OpenAI chat completion (JSON). Via banking-api-connectivity HTTPRoute."
          }
        },
        {
          "name": "POST /api/v1/chat/completions (SSE)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "text/event-stream" },
              { "key": "x-consumer-id", "value": "postman" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"banking-mock-gpt\",\n  \"messages\": [\n    { \"role\": \"user\", \"content\": \"Summarize my financial situation.\" }\n  ],\n  \"stream\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "https://{{gateway_host}}/api/v1/chat/completions",
              "protocol": "https",
              "host": ["{{gateway_host}}"],
              "path": ["api", "v1", "chat", "completions"]
            },
            "description": "Mock OpenAI chat completion (SSE streaming)."
          }
        }
      ]
    },
    {
      "name": "Test Endpoints",
      "item": [
        {
          "name": "GET /api/test/mode",
          "request": {
            "method": "GET",
            "header": [{ "key": "api-key", "value": "{{api_key}}" }],
            "url": {
              "raw": "https://{{gateway_host}}/api/test/mode",
              "protocol": "https",
              "host": ["{{gateway_host}}"],
              "path": ["api", "test", "mode"]
            },
            "description": "Returns the backend's current failure mode (normal, chaos) and the configured fail rate."
          }
        },
        {
          "name": "POST /api/test/mode",
          "request": {
            "method": "POST",
            "header": [
              { "key": "api-key", "value": "{{api_key}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mode\": \"chaos\",\n  \"failRate\": 0.5\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "https://{{gateway_host}}/api/test/mode",
              "protocol": "https",
              "host": ["{{gateway_host}}"],
              "path": ["api", "test", "mode"]
            },
            "description": "Sets the backend's failure mode. `mode`: `normal` | `chaos`. `failRate`: 0.0–1.0."
          }
        },
        {
          "name": "GET /api/test/flaky",
          "request": {
            "method": "GET",
            "header": [{ "key": "api-key", "value": "{{api_key}}" }],
            "url": {
              "raw": "https://{{gateway_host}}/api/test/flaky?failRate=0.5",
              "protocol": "https",
              "host": ["{{gateway_host}}"],
              "path": ["api", "test", "flaky"],
              "query": [
                {
                  "key": "failRate",
                  "value": "0.5",
                  "description": "Failure probability (0.0–1.0)"
                }
              ]
            },
            "description": "Endpoint with random failure. Returns 200 or 500 based on `failRate`."
          }
        },
        {
          "name": "GET /api/test/echo-error",
          "request": {
            "method": "GET",
            "header": [{ "key": "api-key", "value": "{{api_key}}" }],
            "url": {
              "raw": "https://{{gateway_host}}/api/test/echo-error?status=503&delay=500",
              "protocol": "https",
              "host": ["{{gateway_host}}"],
              "path": ["api", "test", "echo-error"],
              "query": [
                {
                  "key": "status",
                  "value": "503",
                  "description": "HTTP status to return"
                },
                {
                  "key": "delay",
                  "value": "500",
                  "description": "Delay in ms before responding"
                },
                {
                  "key": "size",
                  "value": null,
                  "description": "Response payload size in bytes",
                  "disabled": true
                }
              ]
            },
            "description": "Returns the specified HTTP status after the delay. Useful for testing circuit breakers and timeouts."
          }
        }
      ]
    },
    {
      "name": "Auth — Validation",
      "item": [
        {
          "name": "GET without API key (401 expected)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "x-flow-trace-id", "value": "postman-{{$randomUUID}}" }
            ],
            "url": {
              "raw": "https://{{gateway_host}}/api/v1/accounts/summary",
              "protocol": "https",
              "host": ["{{gateway_host}}"],
              "path": ["api", "v1", "accounts", "summary"]
            },
            "description": "Validates that the gateway returns 401 when the API key is absent."
          }
        },
        {
          "name": "GET with an invalid API key (401 expected)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "api-key", "value": "wrong-key" },
              { "key": "x-flow-trace-id", "value": "postman-{{$randomUUID}}" }
            ],
            "url": {
              "raw": "https://{{gateway_host}}/api/v1/accounts/summary",
              "protocol": "https",
              "host": ["{{gateway_host}}"],
              "path": ["api", "v1", "accounts", "summary"]
            },
            "description": "Validates that Authorino rejects invalid API keys with 401."
          }
        }
      ]
    }
  ]
}
