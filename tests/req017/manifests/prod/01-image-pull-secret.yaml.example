# Optional: copy to 01-image-pull-secret.yaml and fill credentials for a private Quay repo.
#
#   cp 01-image-pull-secret.yaml.example 01-image-pull-secret.yaml
#   # edit .dockerconfigjson, then:
#   oc apply -f 01-image-pull-secret.yaml
#
# Deployments reference secret name quay-mcp-pull when MCP_USE_PULL_SECRET=true
# (see apply-prod.sh).
apiVersion: v1
kind: Secret
metadata:
  name: quay-mcp-pull
  namespace: rhcl-mcp-lab
  labels:
    rhcl-lab/requirement: req017-mcp-catalog
type: kubernetes.io/dockerconfigjson
stringData:
  .dockerconfigjson: |
    {
      "auths": {
        "quay.io": {
          "auth": "REPLACE_WITH_BASE64_user:password"
        }
      }
    }
