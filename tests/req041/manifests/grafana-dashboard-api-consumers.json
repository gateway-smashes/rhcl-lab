  "id": null,
  "uid": "rhcl-api-consumers",
  "title": "RHCL API Consumers",
  "description": "Req 41 \u2014 per-consumer API traffic, latency, and status code breakdown. Consumer identity is derived from the x-consumer-id request header.",
  "tags": [
    "rhcl",
    "kuadrant",
    "api",
    "req041",
    "consumers"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "schemaVersion": 38,
  "version": 1,
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "queryValue": "",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "current": {},
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(istio_requests_total, source_workload)",
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "gateway",
        "label": "Gateway",
        "options": [],
        "query": {
          "query": "label_values(istio_requests_total, source_workload)",
          "refId": "gateway"
        },
        "refresh": 2,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      },
      {
        "current": {},
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(istio_requests_total{source_workload=~\"$gateway\"}, route_name)",
        "hide": 0,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "name": "httproute",
        "label": "HTTPRoute",
        "options": [],
        "query": {
          "query": "label_values(istio_requests_total{source_workload=~\"$gateway\"}, route_name)",
          "refId": "httproute"
        },
        "refresh": 2,
        "regex": "/(.+)\\.[0-9]+/",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      },
      {
        "current": {},
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(istio_requests_total{source_workload=~\"$gateway\"}, request_headers_x_consumer_id)",
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "consumer",
        "label": "Consumer",
        "options": [],
        "query": {
          "query": "label_values(istio_requests_total{source_workload=~\"$gateway\"}, request_headers_x_consumer_id)",
          "refId": "consumer"
        },
        "refresh": 2,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
