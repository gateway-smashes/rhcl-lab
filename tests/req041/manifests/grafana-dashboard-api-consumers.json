      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "label_replace(topk(20, sum by (request_headers_x_consumer_id)(increase(istio_requests_total{source_workload=~\"$gateway\", route_name=~\"$httproute..+\", request_headers_x_consumer_id!=\"\"}[$__range]))), \"request_headers_x_consumer_id\", \"anonymous\", \"request_headers_x_consumer_id\", \"<nil>\")",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "label_replace(sum by (request_headers_x_consumer_id)(rate(istio_requests_total{source_workload=~\"$gateway\", route_name=~\"$httproute..+\", request_headers_x_consumer_id!=\"\"}[5m])), \"request_headers_x_consumer_id\", \"anonymous\", \"request_headers_x_consumer_id\", \"<nil>\")",
          "legendFormat": "",
          "refId": "B",
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "label_replace(histogram_quantile(0.95, sum by (le, request_headers_x_consumer_id)(rate(istio_request_duration_milliseconds_bucket{source_workload=~\"$gateway\", route_name=~\"$httproute..+\", request_headers_x_consumer_id!=\"\"}[5m]))), \"request_headers_x_consumer_id\", \"anonymous\", \"request_headers_x_consumer_id\", \"<nil>\")",
          "legendFormat": "",
          "refId": "C",
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "label_replace(100 * sum by (request_headers_x_consumer_id)(rate(istio_requests_total{source_workload=~\"$gateway\", route_name=~\"$httproute..+\", request_headers_x_consumer_id!=\"\", response_code=~\"5..\"}[5m])) / sum by (request_headers_x_consumer_id)(rate(istio_requests_total{source_workload=~\"$gateway\", route_name=~\"$httproute..+\", request_headers_x_consumer_id!=\"\"}[5m])), \"request_headers_x_consumer_id\", \"anonymous\", \"request_headers_x_consumer_id\", \"<nil>\")",
          "legendFormat": "",
          "refId": "D",
          "instant": true,
          "format": "table"
        }
      ]
