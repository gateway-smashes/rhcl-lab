          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "label_replace(sum by (request_headers_x_consumer_id, response_code)(rate(istio_requests_total{source_workload=~\"$gateway\", route_name=~\"$httproute..+\", request_headers_x_consumer_id=~\"$consumer\", request_headers_x_consumer_id!=\"\"}[5m])), \"request_headers_x_consumer_id\", \"anonymous\", \"request_headers_x_consumer_id\", \"<nil>\")",
          "legendFormat": "{{request_headers_x_consumer_id}} \u2014 {{response_code}}",
          "refId": "A"
        }
      ]
