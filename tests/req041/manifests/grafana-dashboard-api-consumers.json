      "id": 200,
      "title": "Consumer Traffic",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never"
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "id": 10,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "title": "Traffic by Consumer",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "label_replace(sum by (request_headers_x_consumer_id)(rate(istio_requests_total{source_workload=~\"$gateway\", route_name=~\"$httproute..+\", request_headers_x_consumer_id=~\"$consumer\", request_headers_x_consumer_id!=\"\"}[5m])), \"request_headers_x_consumer_id\", \"anonymous\", \"request_headers_x_consumer_id\", \"<nil>\")",
          "legendFormat": "{{request_headers_x_consumer_id}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "id": 11,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "title": "Latency P95 by Consumer",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "label_replace(histogram_quantile(0.95, sum by (le, request_headers_x_consumer_id)(rate(istio_request_duration_milliseconds_bucket{source_workload=~\"$gateway\", route_name=~\"$httproute..+\", request_headers_x_consumer_id=~\"$consumer\", request_headers_x_consumer_id!=\"\"}[5m]))), \"request_headers_x_consumer_id\", \"anonymous\", \"request_headers_x_consumer_id\", \"<nil>\")",
          "legendFormat": "{{request_headers_x_consumer_id}}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
